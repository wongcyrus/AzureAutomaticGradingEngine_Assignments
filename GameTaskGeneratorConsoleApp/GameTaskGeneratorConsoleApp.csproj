<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(UsePrivateTests)' != 'true'">
    <ProjectReference Include="..\AzureProjectTestLib\AzureProjectTestLib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePrivateTests)' == 'true'">
    <PackageReference Include="WongCyrus.AzureProjectTestLib.Private" Version="$(PrivateTestPackageVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GraderFunctionApp\GraderFunctionApp.csproj" />
  </ItemGroup>

</Project>
