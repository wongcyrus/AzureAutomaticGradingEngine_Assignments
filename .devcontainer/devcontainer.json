{
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.19.0"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "1.15.9"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.400",
      "additionalVersions": "8.0.424"
    },
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.6.5"
    }
  },
  "postCreateCommand": "git submodule update --init --recursive && npm ci && npm run providers:get && npm run build",
  "hostRequirements": {
    "memory": "8gb"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "wongcyrus/azure-isekai": {
          "permissions": {
            "contents": "write"
          }
        },
        "wongcyrus/azure-common-construct": {
          "permissions": {
            "contents": "write"
          }
        },
        "wongcyrus/cdktf-azure-providers": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "emeraldwalk.runonsave",
        "github.copilot",
        "github.copilot-chat",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "editorconfig.editorconfig",
        "formulahendry.dotnet-test-explorer",
        "esbenp.prettier-vscode",
        "azuretools.vscode-azurestaticwebapps",
        "ms-azuretools.vscode-azurefunctions"
      ]
    }
  }
}
